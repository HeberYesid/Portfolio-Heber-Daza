# Solo servidor: Vite local y Vercel.
GNEWS_API_KEY=

# Solo servidor, sin prefijo VITE_. Orden: Groq → OpenRouter Free → Gemini.
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Opcional. Sin proveedores disponibles se usan respuestas locales.
GEMINI_API_KEY=
# Opcional: modelo habilitado para tu proyecto en Gemini.
# GEMINI_MODEL=gemini-flash-latest
